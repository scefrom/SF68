		)
		(uuid "a4edab00-8725-40ee-91eb-302c87a05ed8")
	)
	(text "module decoder(\n	_IOS, HADR,\n	_CS,\n	_US, _HWR, _HRD,\n	_CS1FX, _CS3FX,\n	_WR, _RD\n);\n\ninput _IOS;\ninput [7:4] HADR;\noutput _CS;\ninput _US;\ninput _HWR, _HRD;\noutput _CS1FX, _CS3FX;\noutput _WR, _RD;\n\n/* 0xCx to 0xDx */\nassign _CS = !(HADR[7:5] == 0b110) | _IOS;\n\nassign _CS1FX = _CS | HADR[4];\nassign _CS3FX = _CS | !HADR[4];\n\nassign _WR = _CS | _US | _HWR;\nassign _RD = _CS | _US | _HRD;\n\nendmodule\n"
		(exclude_from_sim no)
		(at 139.7 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ca14f5a4-0fa8-42be-8a84-4ce6f76498b0")
	)
